{
  "name": "fernlight-careers-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:component": "npm run test:component:vitest && npm run test:component:cypress",
    "test:component:vitest": "vitest run tests/component",
    "test:component:cypress": "cypress run --component",
    "test:component:cypress:open": "cypress open --component",
    "test:e2e": "cypress run --e2e",
    "test:e2e:open": "cypress open --e2e"
  },
  "dependencies": {
    "lucide-vue-next": "^0.468.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.5.1",
    "cypress": "^15.0.0",
    "jsdom": "^30.1.3",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "^4.0.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.5"
  }
}
